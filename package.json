{
  "name": "sazon-local",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo y directorio gastronómico local: Angular + Express + Google Sheets sobre Vercel.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "dev": "npm run dev:backend",
    "dev:frontend": "npm run start --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "start:backend": "npm run start --workspace backend",
    "install:all": "npm install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": "20.x"
  }
}
