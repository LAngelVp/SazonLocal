# ============================================================
# SazónLocal — variables de entorno del backend
# Copia este archivo como .env (solo desarrollo local).
# En Vercel se configuran en Project Settings → Environment Variables.
# ============================================================

# Servidor
PORT=3000
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma.
# En local: http://localhost:4200
# En producción: https://tu-dominio.vercel.app
CORS_ORIGIN=http://localhost:4200

# ---------- Google Sheets ----------
# ID del spreadsheet (lo encontrarás entre /d/ y /edit en la URL)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# Correo del Service Account (termina en @...iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=sazon-local@proyecto.iam.gserviceaccount.com
# Clave privada completa del JSON del Service Account.
# Conserva los saltos de línea como \n dentro del valor.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ---------- Autenticación ----------
# Cadena larga y aleatoria (mínimo 32 caracteres).
JWT_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=24h

# Estado con el que se publican los negocios nuevos: APROBADO | PENDIENTE
AUTO_APPROVE_BUSINESS=APROBADO

# ---------- Caché ----------
# TTL del caché en memoria del listado público (milisegundos).
BUSINESSES_CACHE_TTL_MS=30000

# ---------- ImgBB (opcional) ----------
# Si se define, el formulario puede subir imágenes además de pegar URLs.
IMGBB_API_KEY=
